import com.lalit.poc.taxonomy.AdobeCustomerId
import com.lalit.poc.taxonomy.AddressLine
import com.lalit.poc.taxonomy.AddressLine1
import com.lalit.poc.taxonomy.AddressLine2
import com.lalit.poc.taxonomy.CompanyName
import com.lalit.poc.taxonomy.CountryCode
import com.lalit.poc.taxonomy.CustomerAccountStatus
import com.lalit.poc.taxonomy.CustomerContactPreference
import com.lalit.poc.taxonomy.CustomerCommunicationConsent
import com.lalit.poc.taxonomy.CustomerDateOfBirth
import com.lalit.poc.taxonomy.CustomerEmailAddress
import com.lalit.poc.taxonomy.CustomerFirstName
import com.lalit.poc.taxonomy.CustomerLastName
import com.lalit.poc.taxonomy.DefaultBillingAddressFlag
import com.lalit.poc.taxonomy.DefaultShippingAddressFlag
import com.lalit.poc.taxonomy.FaxNumber
import com.lalit.poc.taxonomy.MobileNumber
import com.lalit.poc.taxonomy.Postcode
import com.lalit.poc.taxonomy.RegionCode
import com.lalit.poc.taxonomy.RegionName
import com.lalit.poc.taxonomy.SapCustomerNumber
import com.lalit.poc.taxonomy.TelephoneNumber
import com.lalit.poc.taxonomy.Town

namespace com.lalit.poc.adobe

[[ Adobe-owned identifiers and extensibility keys are not shared business facts. ]]
type AdobeAddressId inherits String
type AdobeRegionId inherits Int
type AdobeCustomAttributeCode inherits String
type AdobeCustomAttributeValue inherits String

enum AdobeCustomerAccountStatus {
   ACTIVE("ACTIVE") synonym of CustomerAccountStatus.ACTIVE,
   BLOCKED("BLOCKED") synonym of CustomerAccountStatus.BLOCKED,
   DEACTIVE("DEACTIVE") synonym of CustomerAccountStatus.DEACTIVATED,
   DECLINED("DECLINED") synonym of CustomerAccountStatus.DECLINED,
   INPROCESS("INPROCESS") synonym of CustomerAccountStatus.IN_PROCESS,
   ONHOLD("ONHOLD") synonym of CustomerAccountStatus.ON_HOLD
}

[[ Adobe reads 1/0 on ingress but emits true/false on the reverse route. ]]
enum AdobeEmailCommunicationFlag {
   ONE("1") synonym of CustomerCommunicationConsent.ENABLED,
   TRUE("true") synonym of CustomerCommunicationConsent.ENABLED,
   ZERO("0") synonym of CustomerCommunicationConsent.DISABLED,
   FALSE("false") synonym of CustomerCommunicationConsent.DISABLED
}

enum AdobePostCommunicationFlag {
   ONE("1") synonym of CustomerCommunicationConsent.ENABLED,
   TRUE("true") synonym of CustomerCommunicationConsent.ENABLED,
   ZERO("0") synonym of CustomerCommunicationConsent.DISABLED,
   FALSE("false") synonym of CustomerCommunicationConsent.DISABLED
}

closed model AdobeRegion {
   region_code : RegionCode?
   region : RegionName?
   region_id : AdobeRegionId?
}

closed model AdobeAddress {
   id : AdobeAddressId?
   customer_id : AdobeCustomerId?
   region : AdobeRegion?
   region_id : AdobeRegionId?
   country_id : CountryCode
   street : AddressLine[]
   company : CompanyName?
   telephone : TelephoneNumber
   alt_telephone : MobileNumber?
   fax : FaxNumber?
   postcode : Postcode
   city : Town
   firstname : CustomerFirstName?
   lastname : CustomerLastName?
   default_shipping : DefaultShippingAddressFlag?
   default_billing : DefaultBillingAddressFlag
}

parameter closed model AdobeCustomAttribute {
   attribute_code : AdobeCustomAttributeCode
   [[ BIP's Adobe customer-account contract carries custom-attribute values as strings. ]]
   value : AdobeCustomAttributeValue
}

[[
  The jsonPath fields expose facts hidden inside Adobe arrays without changing
  the Adobe wire payload. The default billing address is the BIP rule.
]]
closed model AdobeCustomerAccount {
   id : AdobeCustomerId
   email : CustomerEmailAddress
   firstname : CustomerFirstName
   lastname : CustomerLastName
   dob : CustomerDateOfBirth
   addresses : AdobeAddress[]
   custom_attributes : AdobeCustomAttribute[]

   sapCustomerNumber : SapCustomerNumber by jsonPath("$.custom_attributes[?(@.attribute_code=='sap_unique_id')].value")
   accountStatus : AdobeCustomerAccountStatus by jsonPath("$.custom_attributes[?(@.attribute_code=='cellar_plan_status')].value")
   allowEmailCommunication : AdobeEmailCommunicationFlag by jsonPath("$.custom_attributes[?(@.attribute_code=='allow_email_communication')].value")
   allowPostCommunication : AdobePostCommunicationFlag by jsonPath("$.custom_attributes[?(@.attribute_code=='allow_post_communication')].value")
   contactPreference : CustomerContactPreference by when {
      (this.allowEmailCommunication == AdobeEmailCommunicationFlag.ONE || this.allowEmailCommunication == AdobeEmailCommunicationFlag.TRUE) && (this.allowPostCommunication == AdobePostCommunicationFlag.ONE || this.allowPostCommunication == AdobePostCommunicationFlag.TRUE) -> CustomerContactPreference.EMAIL_AND_POST
      this.allowEmailCommunication == AdobeEmailCommunicationFlag.ONE || this.allowEmailCommunication == AdobeEmailCommunicationFlag.TRUE -> CustomerContactPreference.EMAIL_ONLY
      this.allowPostCommunication == AdobePostCommunicationFlag.ONE || this.allowPostCommunication == AdobePostCommunicationFlag.TRUE -> CustomerContactPreference.POST_ONLY
      else -> CustomerContactPreference.NONE
   }

   billingAddressLine1 : AddressLine1 by jsonPath("$.addresses[?(@.default_billing==true)].street[0]")
   billingAddressLine2 : AddressLine2? by jsonPath("$.addresses[?(@.default_billing==true)].street[1]")
   billingTown : Town by jsonPath("$.addresses[?(@.default_billing==true)].city")
   billingPostcode : Postcode by jsonPath("$.addresses[?(@.default_billing==true)].postcode")
   billingCountryCode : CountryCode by jsonPath("$.addresses[?(@.default_billing==true)].country_id")
   billingRegionCode : RegionCode? by jsonPath("$.addresses[?(@.default_billing==true)].region.region_code")
   billingTelephone : TelephoneNumber by jsonPath("$.addresses[?(@.default_billing==true)].telephone")
   billingMobile : MobileNumber? by jsonPath("$.addresses[?(@.default_billing==true)].alt_telephone")
}

parameter closed model AdobeWriteRegion {
   region_code : RegionCode?
}

parameter closed model AdobeWriteAddress {
   region : AdobeWriteRegion?
   country_id : CountryCode
   street : AddressLine[] by [AddressLine1, AddressLine2]
   telephone : TelephoneNumber
   alt_telephone : MobileNumber?
   postcode : Postcode
   city : Town
   firstname : CustomerFirstName
   lastname : CustomerLastName
   default_shipping : DefaultShippingAddressFlag by true
   default_billing : DefaultBillingAddressFlag by true
}

[[ Exact Adobe PUT body shape: { "customer": { ... } }. ]]
parameter closed model AdobeCustomerWriteAccount {
   id : AdobeCustomerId
   email : CustomerEmailAddress
   firstname : CustomerFirstName
   lastname : CustomerLastName
   dob : CustomerDateOfBirth
   addresses : AdobeWriteAddress[] by [{
      region : { region_code : RegionCode },
      country_id : CountryCode,
      street : [AddressLine1, AddressLine2],
      telephone : TelephoneNumber,
      alt_telephone : MobileNumber,
      postcode : Postcode,
      city : Town,
      firstname : CustomerFirstName,
      lastname : CustomerLastName,
      default_shipping : true,
      default_billing : true
   }]
   custom_attributes : AdobeCustomAttribute[] by [
      { attribute_code : "sap_unique_id", value : (AdobeCustomAttributeValue) SapCustomerNumber },
      { attribute_code : "cellar_plan_status", value : (AdobeCustomAttributeValue) AdobeCustomerAccountStatus },
      {
         attribute_code : "allow_email_communication",
         value : (AdobeCustomAttributeValue) when {
            CustomerContactPreference == CustomerContactPreference.EMAIL_ONLY || CustomerContactPreference == CustomerContactPreference.EMAIL_AND_POST -> "true"
            else -> "false"
         }
      },
      {
         attribute_code : "allow_post_communication",
         value : (AdobeCustomAttributeValue) when {
            CustomerContactPreference == CustomerContactPreference.POST_ONLY || CustomerContactPreference == CustomerContactPreference.EMAIL_AND_POST -> "true"
            else -> "false"
         }
      }
   ]
}

parameter closed model AdobeCustomerWriteRequest {
   customer : AdobeCustomerWriteAccount
}

closed model AdobeCustomerWriteResponse {
   id : AdobeCustomerId?
}
