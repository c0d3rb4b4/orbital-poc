import taxi.http.HttpHeader
import taxi.http.HttpOperation
import taxi.http.RequestBody

import com.lalit.poc.sap.ZbupaCustomerAccountPublishRequest
import com.lalit.poc.taxonomy.CustomerAccountAction
import com.lalit.poc.taxonomy.CustomerAccountCausationId
import com.lalit.poc.taxonomy.CustomerAccountCorrelationId
import com.lalit.poc.taxonomy.CustomerAccountMessageId
import com.lalit.poc.taxonomy.CustomerAccountOrigin

namespace com.lalit.poc.queries

[[
  Both Adobe- and SAP-origin FWT queues contain the canonical SAP IDoc XML.
  Their route-specific workers call this one reusable semantic projection.
]]
@HttpOperation(url = "/api/q/customer-account/to-fwt", method = "POST")
query customerAccountToFwt(
   @RequestBody idoc : ZbupaCustomerAccountPublishRequest,
   @HttpHeader(name = "X-Message-Id") messageId : CustomerAccountMessageId,
   @HttpHeader(name = "X-Correlation-Id") correlationId : CustomerAccountCorrelationId,
   @HttpHeader(name = "X-Causation-Id") causationId : CustomerAccountCausationId?,
   @HttpHeader(name = "X-System-Origin") origin : CustomerAccountOrigin,
   @HttpHeader(name = "X-Account-Action") action : CustomerAccountAction
) {
   given { idoc, messageId, correlationId, causationId, origin, action }
   call com.lalit.poc.services.FwtCustomerService::updateCustomer
}
